# Copy file nay thanh .env va chinh lai gia tri that

# Port server chay
PORT=3000

# URL public cua server (domain hoac IP), KHONG co dau / cuoi
# Vi du: https://event.congty.com  hoac  http://123.45.67.89:3000
BASE_URL=http://localhost:3000

# Mat khau dang nhap trang quan tri
ADMIN_PASSWORD=doimatkhaunay

# Chuoi bi mat cho session (dat ngau nhien, dai)
SESSION_SECRET=doi-chuoi-nay-thanh-ngau-nhien-va-dai

# Kich thuoc frame (px) - anh xuat ra se theo kich thuoc nay
FRAME_WIDTH=1080
FRAME_HEIGHT=1350

# Vi tri + kich thuoc khung chu ky, dat GIUA frame theo yeu cau
# (tinh theo px, goc tren-trai cua khung chu ky)
SIGNATURE_X=290
SIGNATURE_Y=1000
SIGNATURE_WIDTH=500
SIGNATURE_HEIGHT=200
