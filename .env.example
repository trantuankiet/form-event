# Copy file này thành .env rồi chỉnh lại giá trị thật

# Port server chạy
PORT=3000

# URL public của server (domain hoặc IP), KHÔNG có dấu / ở cuối
# Ví dụ: https://event.congty.com  hoặc  http://123.45.67.89:3000
# Trên Render: dùng đúng URL Render cấp, ví dụ https://form-event-mpea.onrender.com
BASE_URL=http://localhost:3000

# Mật khẩu đăng nhập trang quản trị
ADMIN_PASSWORD=doimatkhaunay

# Chuỗi bí mật cho session (đặt ngẫu nhiên, dài)
SESSION_SECRET=doi-chuoi-nay-thanh-ngau-nhien-va-dai

# Kích thước frame (px) - ảnh xuất ra sẽ theo kích thước này
FRAME_WIDTH=1080
FRAME_HEIGHT=1350

# Vị trí + kích thước khung chữ ký, đặt GIỮA frame theo yêu cầu
# (tính theo px, góc trên-trái của khung chữ ký)
SIGNATURE_X=290
SIGNATURE_Y=1000
SIGNATURE_WIDTH=500
SIGNATURE_HEIGHT=200
