<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Quản trị sự kiện</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; background:#f4f5f7; margin:0; padding:24px; }
  .wrap { max-width: 720px; margin: 0 auto; }
  .card { background:#fff; padding:24px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.06); margin-bottom:20px; }
  h1 { font-size:22px; }
  h2 { font-size:17px; margin-top:0; }
  .stat { font-size:32px; font-weight:700; }
  .stat-label { color:#666; font-size:14px; }
  button, .btn { padding:12px 20px; border-radius:8px; border:none; background:#111; color:#fff;
    font-size:15px; cursor:pointer; text-decoration:none; display:inline-block; }
  img.preview { max-width: 220px; border-radius: 8px; display:block; margin: 12px 0; border:1px solid #eee; }
  form.top-right { text-align:right; margin-bottom: -10px; }
  .link-btn { background:none; border:none; color:#666; text-decoration:underline; cursor:pointer; font-size:14px; }
  input[type=file] { display:block; margin: 12px 0; }
  .warn { color:#b45309; background:#fffbeb; padding:10px 14px; border-radius:8px; font-size:14px; }

  .banner { padding: 14px 18px; border-radius: 10px; font-size: 15px; margin-bottom: 20px; }
  .banner-success { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
  .banner-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

  .card-danger { border: 1px solid #fecaca; }
  .btn-danger-outline {
    padding: 12px 20px; border-radius: 8px; border: 1.5px solid #dc2626;
    background: #fff; color: #dc2626; font-size: 15px; cursor: pointer; font-weight: 600;
  }
  .btn-danger {
    padding: 12px 20px; border-radius: 8px; border: none;
    background: #dc2626; color: #fff; font-size: 15px; cursor: pointer;
    font-weight: 600; margin-top: 10px;
  }
  .btn-danger:disabled { background: #fca5a5; cursor: not-allowed; }
  #reset-confirm-input {
    width: 100%; padding: 12px; border: 1.5px solid #ddd; border-radius: 8px;
    font-size: 15px; margin-bottom: 4px;
  }
  #reset-confirm-input:focus { outline: none; border-color: #dc2626; }
  code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-weight: 700; }
</style>
</head>
<body>
<div class="wrap">
  <form class="top-right" method="POST" action="/admin/logout">
    <button type="submit" class="link-btn">Đăng xuất</button>
  </form>
  <h1>Bảng điều khiển sự kiện</h1>

  <% if (resetStatus === 'success') { %>
    <div class="banner banner-success">✓ Đã reset thành công. Toàn bộ dữ liệu khách và ảnh đã được xoá, số đếm đã về 0.</div>
  <% } else if (resetStatus === 'error') { %>
    <div class="banner banner-error">✕ Có lỗi khi reset, vui lòng thử lại hoặc liên hệ kỹ thuật.</div>
  <% } %>

  <div class="card">
    <h2>Số lượt đã điền form</h2>
    <div class="stat"><%= count %></div>
    <div class="stat-label">khách đã ký & nhận ảnh</div>
    <a class="btn" href="/admin/export" style="margin-top:16px;">⬇ Xuất Excel danh sách</a>
  </div>

  <div class="card">
    <h2>Frame / Background sự kiện</h2>
    <% if (!hasCustomFrame) { %>
      <p class="warn">Chưa có frame thật nào được tải lên. Hệ thống đang tạm dùng <strong>frame mẫu</strong> bên dưới để khách vẫn thao tác được bình thường — hãy tải lên frame thật của sự kiện trước khi khai mạc.</p>
    <% } else { %>
      <p>Frame hiện tại (frame thật của sự kiện):</p>
    <% } %>
    <img class="preview" src="<%= frameUrl %>" alt="frame hien tai" />
    <form method="POST" action="/admin/upload-frame" enctype="multipart/form-data">
      <input type="file" name="frame" accept="image/png,image/jpeg" required />
      <button type="submit">Tải lên / Thay frame mới</button>
    </form>
    <p style="color:#888; font-size:13px;">Lưu ý: đổi frame chỉ áp dụng cho ảnh tạo SAU thời điểm tải lên, ảnh cũ đã sinh trước đó không đổi.</p>
  </div>
  <div class="card card-danger">
    <h2>⚠ Reset dữ liệu (chuẩn bị sự kiện mới)</h2>
    <p style="color:#666; font-size:14px;">
      Dùng khi muốn xoá sạch dữ liệu để bắt đầu sự kiện mới, hoặc xoá dữ liệu
      nhập thử trước khi sự kiện thật diễn ra. Thao tác này sẽ xoá
      <strong>toàn bộ <%= count %> lượt khách đã check-in</strong> và toàn bộ
      ảnh đã tạo, đưa số đếm về 0. <strong>Frame hiện tại sẽ được giữ nguyên,
      không bị xoá.</strong>
    </p>
    <p class="warn" style="margin-bottom:16px;">
      Hành động này <strong>KHÔNG THỂ hoàn tác</strong>. Hãy chắc chắn đã xuất
      Excel backup nếu còn cần dữ liệu hiện tại trước khi reset.
    </p>

    <button id="reset-toggle-btn" type="button" class="btn-danger-outline">
      Tôi muốn reset dữ liệu
    </button>

    <form id="reset-form" method="POST" action="/admin/reset" style="display:none; margin-top:16px;">
      <label style="display:block; margin-bottom:8px; font-size:14px;">
        Gõ chính xác chữ <code>XOA</code> vào ô bên dưới để mở khoá nút xác nhận:
      </label>
      <input type="text" id="reset-confirm-input" placeholder="Gõ XOA để xác nhận" autocomplete="off" />
      <button type="submit" id="reset-submit-btn" class="btn-danger" disabled>
        Xác nhận xoá toàn bộ dữ liệu
      </button>
    </form>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('reset-toggle-btn');
  const resetForm = document.getElementById('reset-form');
  const resetInput = document.getElementById('reset-confirm-input');
  const resetSubmitBtn = document.getElementById('reset-submit-btn');

  toggleBtn.addEventListener('click', () => {
    const showing = resetForm.style.display !== 'none';
    resetForm.style.display = showing ? 'none' : 'block';
    toggleBtn.textContent = showing ? 'Tôi muốn reset dữ liệu' : 'Ẩn form reset';
  });

  resetInput.addEventListener('input', () => {
    resetSubmitBtn.disabled = resetInput.value.trim() !== 'XOA';
  });

  // Lop xac nhan thu 2: popup canh bao cuoi cung ngay truoc khi thuc su gui request xoa.
  resetForm.addEventListener('submit', (e) => {
    const ok = confirm(
      'XÁC NHẬN LẦN CUỐI: Bạn sắp XOÁ VĨNH VIỄN toàn bộ dữ liệu khách hàng đã check-in. ' +
      'Hành động này KHÔNG THỂ hoàn tác. Bạn có chắc chắn muốn tiếp tục?'
    );
    if (!ok) e.preventDefault();
  });
</script>
</body>
</html>
